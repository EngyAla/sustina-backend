// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  ORG_MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum EmployeePermissionType {
  VIEW
  DATA_ENTRY
  FILE_UPLOAD
  EDIT
  DELETE
}

model Sector {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  industries Industry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Industry {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  sectorId String
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  subIndustries SubIndustry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectorId, name])
  @@index([sectorId, isActive, sortOrder])
}

model SubIndustry {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)

  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([industryId, name])
  @@index([industryId, isActive, sortOrder])
}

// ==========================================
// ORGANIZATIONS
// ==========================================

model Organization {
  id                 String @id @default(uuid())
  legalName          String
  hqCountry          String
  firstReportingYear Int

  status OrganizationStatus @default(PENDING)

  subIndustryId String
  subIndustry   SubIndustry @relation(fields: [subIndustryId], references: [id], onDelete: Restrict)

  users                User[]
  registrationRequests RegistrationRequest[]
  documents            OrganizationDocument[]
  departments          Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subIndustryId])
  @@index([status])
}

// ==========================================
// USERS
// ==========================================

model User {
  id String @id @default(uuid())

  firstName    String?
  lastName     String?
  email        String  @unique
  passwordHash String?

  role   UserRole   @default(ORG_MEMBER)
  status UserStatus @default(PENDING)

  // Null is allowed for SUPER_ADMIN accounts only.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  permissions UserPermission[]
  invitation  EmployeeInvitation?

  deletedAt          DateTime?
  deactivationReason String?

  submittedRegistrationRequests RegistrationRequest[] @relation("RegistrationSubmitter")
  reviewedRegistrationRequests  RegistrationRequest[] @relation("RegistrationReviewer")

  refreshSessions   RefreshSession[]
  passwordResetOtps PasswordResetOtp[]

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

// ==========================================
// Department
// ==========================================

model Department {
  id             String @id @default(uuid())
  name           String
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users     User[]
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive, sortOrder])
}

// ==========================================
// User Permission
// ==========================================

model UserPermission {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission EmployeePermissionType

  createdAt DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// ==========================================
// Employee Invitation
// ==========================================

model EmployeeInvitation {
  id String @id @default(uuid())

  userId String @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ==========================================
// REGISTRATION REQUESTS
// ==========================================

model RegistrationRequest {
  id            String @id @default(uuid())
  referenceCode String @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  submittedById String
  submittedBy   User   @relation("RegistrationSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  reviewedById String?
  reviewedBy   User?   @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  status          RegistrationRequestStatus @default(PENDING)
  rejectionReason String?

  termsAcceptedAt     DateTime
  authorityAttestedAt DateTime

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  documents OrganizationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([status, submittedAt])
}

// ==========================================
// ORGANIZATION DOCUMENTS
// ==========================================

model OrganizationDocument {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  registrationRequestId String
  registrationRequest   RegistrationRequest @relation(fields: [registrationRequestId], references: [id], onDelete: Restrict)

  originalFileName String
  mimeType         String
  sizeBytes        Int

  cloudinaryPublicId String @unique
  secureUrl          String

  sha256     String
  scanStatus DocumentScanStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([registrationRequestId])
  @@index([sha256])
  @@index([scanStatus])
}

model RefreshSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetOtp {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}