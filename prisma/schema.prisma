// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  ORG_MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum EmployeePermissionType {
  VIEW
  DATA_ENTRY
  FILE_UPLOAD
  EDIT
  DELETE
}

enum ESGCategory {
  ENVIRONMENTAL
  SOCIAL
  GOVERNANCE
}

enum DataFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum DataEntryStatus {
  DRAFT
  SUBMITTED
}

enum SupportingDocumentType {
  EVIDENCE
  OTHER
}

model Sector {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  industries Industry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Industry {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  sectorId String
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  subIndustries SubIndustry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectorId, name])
  @@index([sectorId, isActive, sortOrder])
}

model SubIndustry {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)

  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([industryId, name])
  @@index([industryId, isActive, sortOrder])
}

// ==========================================
// ORGANIZATIONS
// ==========================================

model Organization {
  id                 String @id @default(uuid())
  legalName          String
  hqCountry          String
  firstReportingYear Int

  status OrganizationStatus @default(PENDING)

  subIndustryId String
  subIndustry   SubIndustry @relation(fields: [subIndustryId], references: [id], onDelete: Restrict)

  users                User[]
  registrationRequests RegistrationRequest[]
  documents            OrganizationDocument[]

  departments Department[]
  dataItems   DataItem[]

  dataEntries         DataEntry[]
  supportingDocuments SupportingDocument[]

  permissions Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subIndustryId])
  @@index([status])
}

// ==========================================
// USERS
// ==========================================

model User {
  id String @id @default(uuid())

  firstName    String?
  lastName     String?
  email        String  @unique
  passwordHash String?

  role   UserRole   @default(ORG_MEMBER)
  status UserStatus @default(PENDING)

  // Null is allowed for SUPER_ADMIN accounts only.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  permissions           UserPermission[]
  permissionAssignments EmployeePermissionAssignment[]
  invitation            EmployeeInvitation?

  deletedAt          DateTime?
  deactivationReason String?

  submittedRegistrationRequests RegistrationRequest[] @relation("RegistrationSubmitter")
  reviewedRegistrationRequests  RegistrationRequest[] @relation("RegistrationReviewer")

  dataEntriesCreated   DataEntry[] @relation("DataEntryCreator")
  dataEntriesCollected DataEntry[] @relation("DataEntryCollector")

  uploadedDataDocuments SupportingDocument[] @relation("DataDocumentUploader")

  refreshSessions   RefreshSession[]
  passwordResetOtps PasswordResetOtp[]

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

// ==========================================
// Department
// ==========================================

model Department {
  id             String @id @default(uuid())
  name           String
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users     User[]
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  dataItems DataItem[]

  dataEntries DataEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive, sortOrder])
}

// ==========================================
// User Permission
// ==========================================

model UserPermission {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission EmployeePermissionType

  createdAt DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// ==========================================
// CUSTOM PERMISSIONS
// ==========================================

model Permission {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  operations PermissionOperation[]

  assignedEmployees EmployeePermissionAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
}

model PermissionOperation {
  id String @id @default(uuid())

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  operation EmployeePermissionType

  createdAt DateTime @default(now())

  @@unique([permissionId, operation])
  @@index([permissionId])
}

model EmployeePermissionAssignment {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

// ==========================================
// Employee Invitation
// ==========================================

model EmployeeInvitation {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ==========================================
// REGISTRATION REQUESTS
// ==========================================

model RegistrationRequest {
  id            String @id @default(uuid())
  referenceCode String @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  submittedById String
  submittedBy   User   @relation("RegistrationSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  reviewedById String?
  reviewedBy   User?   @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  status          RegistrationRequestStatus @default(PENDING)
  rejectionReason String?

  termsAcceptedAt     DateTime
  authorityAttestedAt DateTime

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  documents OrganizationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([status, submittedAt])
}

// ==========================================
// ORGANIZATION DOCUMENTS
// ==========================================

model OrganizationDocument {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  registrationRequestId String
  registrationRequest   RegistrationRequest @relation(fields: [registrationRequestId], references: [id], onDelete: Restrict)

  originalFileName String
  mimeType         String
  sizeBytes        Int

  cloudinaryPublicId String @unique
  secureUrl          String

  sha256     String
  scanStatus DocumentScanStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([registrationRequestId])
  @@index([sha256])
  @@index([scanStatus])
}

// ==========================================
// ESG DATA ITEM / KPI CATALOG
// ==========================================

model DataItem {
  id          String        @id @default(uuid())
  code        String
  name        String
  description String?
  category    ESGCategory
  unit        String
  frequency   DataFrequency
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  dataEntries DataEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, departmentId, isActive])
  @@index([organizationId, category, isActive])
  @@index([organizationId, frequency, isActive])
}

model DataEntry {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  dataItemId String
  dataItem   DataItem @relation(fields: [dataItemId], references: [id], onDelete: Restrict)

  // Reporting period
  periodKey   String
  periodStart DateTime
  periodEnd   DateTime

  // KPI value
  value Decimal @db.Decimal(20, 6)
  notes String?

  status DataEntryStatus @default(DRAFT)

  // Person who entered the data
  enteredById String
  enteredBy   User   @relation("DataEntryCreator", fields: [enteredById], references: [id], onDelete: Restrict)

  // Person accountable for collecting the data
  dataCollectorId String
  dataCollector   User   @relation("DataEntryCollector", fields: [dataCollectorId], references: [id], onDelete: Restrict)

  supportingDocuments SupportingDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One entry per KPI per organization per reporting period
  @@unique([organizationId, dataItemId, periodKey])
  @@index([organizationId, departmentId, periodStart])
  @@index([organizationId, status])
  @@index([dataItemId, periodKey])
  @@index([enteredById])
  @@index([dataCollectorId])
}

model SupportingDocument {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dataEntryId String
  dataEntry   DataEntry @relation(fields: [dataEntryId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("DataDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  documentType SupportingDocumentType @default(EVIDENCE)

  originalFileName String
  mimeType         String
  sizeBytes        Int

  cloudinaryPublicId String @unique
  secureUrl          String

  sha256     String
  scanStatus DocumentScanStatus @default(CLEAN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, dataEntryId])
  @@index([uploadedById])
  @@index([sha256])
  @@index([scanStatus])
}

model RefreshSession {
  id        String @id @default(uuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetOtp {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}
